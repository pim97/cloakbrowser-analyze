# 6. Binary diff against stock ungoogled-chromium
RUN cat > /audit/06_binary_comparison.sh << 'SCRIPT'
#!/bin/bash
set -e
echo "================================================================"
echo "  TEST 6: Binary Section Analysis"
echo "================================================================"
echo ""

BINARY=$(python3 -c "from cloakbrowser.config import get_binary_path, get_effective_version; print(get_binary_path(get_effective_version()))")

echo "--- ELF section headers ---"
readelf -S "$BINARY" 2>/dev/null | head -40 || objdump -h "$BINARY" 2>/dev/null | head -40 || echo "(readelf/objdump not available)"
echo ""

echo "--- Shared library dependencies ---"
ldd "$BINARY" 2>/dev/null | head -40 || echo "(ldd not available)"
echo ""

echo "--- Suspicious shared libraries (non-standard) ---"
ldd "$BINARY" 2>/dev/null | grep -vE 'linux-vdso|libpthread|libc\.so|libm\.so|libdl|librt|libgcc|libstdc\+\+|ld-linux|libX|libxcb|libdrm|libgbm|libEGL|libGL|libnss|libnspr|libatk|libcups|libdbus|libpango|libcairo|libgdk|libgtk|libgio|libglib|libgobject|libfontconfig|libfreetype|libasound|libexpat|libffi|libz\.|libpcre|libpng|libharfbuzz|libbrotli|libjpeg|libwebp|libsecret|libresolv|libselinux|libmount|libblkid|libwayland|libxkbcommon|libepoxy|libfribidi|libthai|libdatrie|libpixman|libuuid|libxshmfence|libxrandr|libxcomposite|libxdamage|libxfixes|libxext|libxrender|libxi\b' | \
    head -20 || echo "(none — all standard libraries)"
echo ""

echo "--- Binary file type ---"
file "$BINARY"
echo ""

echo "--- Code signing / debug info ---"
readelf -n "$BINARY" 2>/dev/null | head -20 || echo "(no notes section)"
echo ""
SCRIPT

