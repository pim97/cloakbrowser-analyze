echo "--- Unexpected processes (not chrome, python, or standard system) ---"
ps aux | grep -vE 'chrom|python|ps|grep|bash|sh|Xvfb|sleep|init|entrypoint' | \
    tail -n +2 | head -20 || echo "(none — good)"
