# 8. Outbound connection test with firewall
RUN cat > /audit/08_blocked_network_test.sh << 'SCRIPT'
#!/bin/bash
set -e
echo "================================================================"
echo "  TEST 8: Behavior When Network is Blocked"
echo "================================================================"
echo ""
echo "Testing if browser crashes or behaves differently without network..."
echo "(Malware often fails when it can't phone home)"
echo ""

# Start Xvfb
Xvfb :99 -screen 0 1920x1080x24 > /dev/null 2>&1 &
